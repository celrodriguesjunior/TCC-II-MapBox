{
  "Collector": {
    "OutputDirectory": "data/raw",
    "SegmentsFile": "data/reference/segments.json",

    "DailyRequestBudget": 2400,
    "RequestsPerSecond": 4,

    "CadenceMinutesByTier": {
      "Espinha": 10,
      "Coletora": 30,
      "Secundaria": 90
    },

    "WeatherCadenceMinutes": 20,

    "TomTom": {
      "BaseUrl": "https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Extensions.Http": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",

      // Só o que exigiu retentativa. Em nível Information, o Polly registra toda tentativa
      // bem-sucedida e afoga o log útil numa coleta de semanas.
      "Polly": "Warning"
    }
  }
}
